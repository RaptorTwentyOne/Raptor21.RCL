@* A NATIVE <dialog>, opened with showModal() by Client/src/modal/ModalComponent.ts.
   Not a <div> at --rg-z-modal: the sidebar rail is a popover, i.e. in the TOP LAYER, and no z-index in
   the normal layer reaches it (measured — a probe at z-index 2147483647 still hit-tested UNDER an open
   rail). As a <div> this dialog was measured painting sliced in half at the rail's edge, with the rail's
   whole rect dead to the pointer in both directions. `showModal()` puts it in the top layer, closes the
   rail as it opens, and makes the rest of the document inert without anyone writing `inert`.

   It renders CLOSED — the UA's `dialog:not([open])` is reinforced at author specificity in
   Client/src/styles/modal/_modal.scss, so nothing paints in the normal layer for the frame between the
   htmx swap and the component mounting. *@
<dialog class="rg-modal" data-rg-component="modal"
        aria-labelledby="@(string.IsNullOrEmpty(Title) ? null : _titleId)"
        data-rg-modal-static="@(Static ? "" : null)"
        data-rg-modal-id="@(string.IsNullOrEmpty(Id) ? null : Id)">
    <div class="@DialogClass" data-rg-modal-dialog>
        @if (!string.IsNullOrEmpty(Title) || Dismissible)
        {
            <div class="rg-modal-head">
                @if (!string.IsNullOrEmpty(Title))
                {
                    <h2 class="rg-modal-title" id="@_titleId">@Title</h2>
                }
                @if (Dismissible)
                {
                    <button type="button" class="rg-modal-x" data-rg-modal-close aria-label="Close">×</button>
                }
            </div>
        }
        <div class="rg-modal-body">
            @ChildContent
        </div>
    </div>
</dialog>

@code {
    /// <summary>
    /// Names this modal (RFC 0001). A LITERAL id makes the source generator emit an accessor class in the
    /// declaring component's assembly — <c>TestModal.Url(...)</c>/<c>.Base</c>/<c>.Id</c>, aliasing the
    /// declaring routed component's own GET endpoint — and the value is rendered as
    /// <c>data-rg-modal-id</c> for client-side addressing. Host-visible naming stays unbranded by rule.
    /// </summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>Heading text. Omit to render no header — the content then owns the whole dialog.</summary>
    [Parameter] public string? Title { get; set; }

    [Parameter] public ModalSize Size { get; set; } = ModalSize.Medium;

    /// <summary>Suppresses dismissal by backdrop click and Escape (destructive confirmations).</summary>
    [Parameter] public bool Static { get; set; }

    /// <summary>Render the close (×) button in the header.</summary>
    [Parameter] public bool Dismissible { get; set; } = true;

    /// <summary>Extra classes on the dialog element.</summary>
    [Parameter] public string? Class { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private readonly string _titleId = $"rg-modal-title-{Guid.NewGuid():N}";

    private string DialogClass =>
        string.IsNullOrWhiteSpace(Class)
            ? $"rg-modal-dialog rg-modal-{SizeClass(Size)}"
            : $"rg-modal-dialog rg-modal-{SizeClass(Size)} {Class}";

    private static string SizeClass(ModalSize size) => size switch
    {
        ModalSize.Small => "sm",
        ModalSize.Large => "lg",
        ModalSize.ExtraLarge => "xl",
        ModalSize.Full => "full",
        _ => "md",
    };
}
