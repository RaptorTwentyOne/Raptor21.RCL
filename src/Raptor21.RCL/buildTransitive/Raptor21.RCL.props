<Project>
  <!-- Makes the routes-class-name override visible to the RaptorRoutes source generator. The generated
       class is named "Routes" by default — deliberately unbranded, because it lives in host markup — and a
       host that already owns a type called Routes can rename it:

           <PropertyGroup>
             <RaptorRoutesClassName>AppRoutes</RaptorRoutesClassName>
           </PropertyGroup>
  -->
  <ItemGroup>
    <CompilerVisibleProperty Include="RaptorRoutesClassName" />
  </ItemGroup>

  <!-- Feeds the project's .razor markup to the source generator as AdditionalFiles, which is how
       data-rg-modal-link="<id>" opener declarations become generated accessor classes (RFC 0001 Part 2(b):
       <Id>.Url / .Id / .Query). A generator cannot see Razor sources any other way — the Razor compiler's
       output is not an input to other generators. Opt out per project with
       <RaptorScanRazorMarkup>false</RaptorScanRazorMarkup>. -->
  <ItemGroup Condition="'$(RaptorScanRazorMarkup)' != 'false'">
    <AdditionalFiles Include="**/*.razor" Exclude="**/bin/**;**/obj/**" />
  </ItemGroup>
</Project>
