<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Raptor21.RCL</RootNamespace>
    <AssemblyName>Raptor21.RCL</AssemblyName>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Trim-analysis is ON for good: the reflective fallbacks are RequiresUnreferencedCode-gated, the
         component-type flows are DynamicallyAccessedMembers-annotated, and the remaining reflection STJ
         sites carry justified suppressions. Full NativeAOT stays out of reach until Razor Components
         supports it (see AddRaptor21). -->
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <IsPackable>true</IsPackable>
    <PackageId>Raptor21.RCL</PackageId>
    <Version>0.3.0-preview.17</Version>
    <Description>Server-rendered Razor component library for ASP.NET Core static SSR, driven by htmx: grid, filter, forms, modals, charts and page composition.</Description>
    <PackageTags>razor;razor-components;blazor-ssr;grid;filter;htmx;rcl</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>RaptorTwentyOne</Authors>
    <PackageProjectUrl>https://github.com/RaptorTwentyOne/Raptor21</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RaptorTwentyOne/Raptor21</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Label="Source generator">
    <!-- The RaptorRoutes generator ships INSIDE this package (analyzers/dotnet/cs), so every consumer gets
         typed route accessors with the same PackageReference they already have — no second package.
         ReferenceOutputAssembly=false: the generator is a build-time component, never a runtime dependency. -->
    <ProjectReference Include="..\Raptor21.RCL.SourceGenerators\Raptor21.RCL.SourceGenerators.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer"
                      PrivateAssets="all" />
    <None Include="..\Raptor21.RCL.SourceGenerators\bin\$(Configuration)\netstandard2.0\Raptor21.RCL.SourceGenerators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Include="buildTransitive\Raptor21.RCL.props" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <None Remove="wwwroot\**" />
  </ItemGroup>

  <!-- The dist glob is expanded HERE, in a target, and not in a static item group: static items are
       evaluated before any target runs, so when RaptorBuildClientBundle rewrites the content-hashed
       bundle in the same invocation, a static glob would hand CSC the PREVIOUS build's file names and
       fail with CS1566 on the first build after any hash change. AssignTargetPaths is the first target
       that consumes EmbeddedResource, so adding the items just before it keeps every later consumer
       (manifest naming, CoreCompile) on the fresh names. -->
  <Target Name="RaptorEmbedClientBundle"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="RaptorBuildClientBundle">
    <ItemGroup>
      <EmbeddedResource Include="wwwroot\dist\**\*" Exclude="wwwroot\dist\**\*.map" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="Client\**\*" Exclude="Client\node_modules\**" />
    <Compile Remove="Client\**" />
    <Content Remove="Client\**" />
    <EmbeddedResource Remove="Client\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Client\types\raptor21.d.ts"
             Pack="true"
             PackagePath="contentFiles\any\any\raptor21.d.ts"
             BuildAction="None"
             CopyToOutput="false"
             Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <RaptorClientDir>$(MSBuildProjectDirectory)\Client</RaptorClientDir>
    <!-- wwwroot/dist is a BUILD OUTPUT, not a source: it left git on 2026-09-01 after the third "committed
         bundle is stale" CI failure in a week. A fresh clone therefore has no bundle, and the client build
         runs by itself on that first build; once a bundle exists an ordinary `dotnet build` reuses it and
         RaptorClientBundleFreshness warns when Client/src is newer. CI and the release pass
         -p:RaptorBuildClient=true, so what ships is always built from source. Node 22 is a prerequisite
         for the first build of a clone. -->
    <RaptorBuildClient Condition="'$(RaptorBuildClient)' == '' And !Exists('$(MSBuildProjectDirectory)\wwwroot\dist\assets-manifest.json')">true</RaptorBuildClient>
    <RaptorBuildClient Condition="'$(RaptorBuildClient)' == ''">false</RaptorBuildClient>
  </PropertyGroup>

  <Target Name="RaptorBuildClientBundle" BeforeTargets="BeforeBuild" Condition="'$(RaptorBuildClient)' == 'true'">
    <Message Importance="high" Text="Raptor21: building client bundle with rspack..." />
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(RaptorClientDir)" />
    <Exec Command="npm run build" WorkingDirectory="$(RaptorClientDir)" />
  </Target>

  <Target Name="RaptorClientBundleCheck" AfterTargets="RaptorBuildClientBundle" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\dist\assets-manifest.json')"
           Text="Raptor21: wwwroot/dist/assets-manifest.json is missing — the client bundle has not been built, so this assembly would embed no stylesheet or script. Run 'npm ci &amp;&amp; npm run build' in Client/, or build with -p:RaptorBuildClient=true." />
  </Target>

  <ItemGroup>
    <RaptorClientSource Include="$(RaptorClientDir)\src\**\*" />
  </ItemGroup>

  <Target Name="RaptorClientBundleFreshness"
          BeforeTargets="BeforeBuild"
          Condition="'$(RaptorBuildClient)' != 'true' And Exists('$(MSBuildProjectDirectory)\wwwroot\dist\assets-manifest.json')"
          Inputs="@(RaptorClientSource)"
          Outputs="$(MSBuildProjectDirectory)\wwwroot\dist\assets-manifest.json">
    <Warning Text="Raptor21: wwwroot/dist is older than Client/src — the embedded bundle does not include your latest client changes. Run 'npm run build' in Client/, or build with -p:RaptorBuildClient=true." />
  </Target>

</Project>
