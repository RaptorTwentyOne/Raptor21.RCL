@if (!string.IsNullOrEmpty(Label))
{
    <RaptorField Label="@Label" For="@Id" Required="@Required" Hint="@Hint">
        <textarea @attributes="Attributes">@Value</textarea>
    </RaptorField>
}
else
{
    <textarea @attributes="Attributes">@Value</textarea>
}

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public int Rows { get; set; } = 3;
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Readonly { get; set; }
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object?>? AdditionalAttributes { get; set; }

    private Dictionary<string, object?> Attributes
    {
        get
        {
            var a = new Dictionary<string, object?>(StringComparer.Ordinal)
            {
                ["rows"] = Rows,
                ["class"] = string.IsNullOrWhiteSpace(Class) ? "rg-textarea" : $"rg-textarea {Class}",
            };
            if (!string.IsNullOrEmpty(Name)) a["name"] = Name;
            if (!string.IsNullOrEmpty(Id)) a["id"] = Id;
            if (!string.IsNullOrEmpty(Placeholder)) a["placeholder"] = Placeholder;
            if (Required) a["required"] = "required";
            if (Disabled) a["disabled"] = "disabled";
            if (Readonly) a["readonly"] = "readonly";
            if (AdditionalAttributes is not null)
                foreach (var kv in AdditionalAttributes)
                    a[kv.Key] = kv.Value;
            return a;
        }
    }
}
