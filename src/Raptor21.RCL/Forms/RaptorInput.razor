@if (!string.IsNullOrEmpty(Label))
{
    <RaptorField Label="@Label" For="@Id" Required="@Required" Hint="@Hint">
        <input @attributes="Attributes"/>
    </RaptorField>
}
else
{
    <input @attributes="Attributes"/>
}

@code {
    /// <summary>When set, self-wraps in a labelled RaptorField.</summary>
    [Parameter] public string? Label { get; set; }

    [Parameter] public string? Hint { get; set; }
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Readonly { get; set; }

    /// <summary>Focus this control when its dialog opens (the modal client reads <c>data-rg-autofocus</c>).</summary>
    [Parameter] public bool Autofocus { get; set; }

    [Parameter] public string? Autocomplete { get; set; }

    /// <summary>Extra classes appended after <c>rg-input</c>.</summary>
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object?>? AdditionalAttributes { get; set; }

    private Dictionary<string, object?> Attributes
    {
        get
        {
            var a = new Dictionary<string, object?>(StringComparer.Ordinal)
            {
                ["type"] = Type,
                ["class"] = string.IsNullOrWhiteSpace(Class) ? "rg-input" : $"rg-input {Class}",
            };
            if (!string.IsNullOrEmpty(Name)) a["name"] = Name;
            if (!string.IsNullOrEmpty(Id)) a["id"] = Id;
            if (Value is not null) a["value"] = Value;
            if (!string.IsNullOrEmpty(Placeholder)) a["placeholder"] = Placeholder;
            if (!string.IsNullOrEmpty(Autocomplete)) a["autocomplete"] = Autocomplete;
            if (Required) a["required"] = "required";
            if (Disabled) a["disabled"] = "disabled";
            if (Readonly) a["readonly"] = "readonly";
            if (Autofocus) a["data-rg-autofocus"] = "";
            if (AdditionalAttributes is not null)
                foreach (var kv in AdditionalAttributes)
                    a[kv.Key] = kv.Value;
            return a;
        }
    }
}
