@using Raptor21.RCL.Map.Models
@using Raptor21.RCL.States

<div class="rg-map @Class" id="@Id" data-rg-component="map" data-rg-state-host="@Current.Wire()" @attributes="AdditionalAttributes">
    <div class="rg-map__canvas" data-rg-map-canvas style="@CanvasStyle" hidden="@(Current != RaptorState.Content)">
        @ChildContent
    </div>

    @if (Loading is not null)
    {
        <div class="rg-map__state" data-rg-state="loading" hidden="@(Current != RaptorState.Loading)">@Loading</div>
    }
    @if (Empty is not null)
    {
        <div class="rg-map__state" data-rg-state="empty" hidden="@(Current != RaptorState.Empty)">@Empty</div>
    }
    @if (Error is not null)
    {
        <div class="rg-map__state" data-rg-state="error" hidden="@(Current != RaptorState.Error)">@Error</div>
    }

    @if (ModelJson is not null)
    {
        <script type="application/json" data-rg-map-data>@((MarkupString)ModelJson)</script>
    }
</div>

@code {

    /// <summary>
    /// Element id. Required: it is how a script reaches this map
    /// (<c>window.raptorMap(id).render(model)</c>).
    /// </summary>
    [Parameter, EditorRequired]
    public string Id { get; set; } = default!;

    /// <summary>Extra classes on the host element, for sizing and placement.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Minimum height for the drawing box.
    /// <para>
    /// Worth setting on every map. The mapping library measures its container as it initialises and a
    /// container that is zero-high at that moment produces a zero-high map that never recovers, because
    /// nothing re-measures it afterwards. A height set up front also keeps the box from collapsing while
    /// the tiles are in flight.
    /// </para>
    /// </summary>
    [Parameter]
    public string? Height { get; set; }

    /// <summary>Painted inside the drawing box until the first render replaces it (a skeleton, usually).</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Which state the map starts in, decided on the server.
    /// <para>
    /// Left null, a map with a <see cref="Loading"/> slot starts in that state and any other starts on the
    /// canvas. Set it when the server already knows the outcome — a query that resolved to no locations
    /// can start in <see cref="RaptorState.Empty"/> or <see cref="RaptorState.Error"/> rather than paint a
    /// skeleton and wait for a draw that will never come.
    /// </para>
    /// </summary>
    [Parameter]
    public RaptorState? State { get; set; }

    /// <summary>Shown while the map has not drawn yet. Supplying it makes <see cref="RaptorState.Loading"/>
    /// the default first paint.</summary>
    [Parameter] public RenderFragment? Loading { get; set; }

    /// <summary>Shown instead of the canvas when there is nothing to place on the map.</summary>
    [Parameter] public RenderFragment? Empty { get; set; }

    /// <summary>Shown instead of the canvas when the map could not be produced.</summary>
    [Parameter] public RenderFragment? Error { get; set; }

    /// <summary>
    /// The map, authored on the server.
    /// <para>
    /// The component serialises it and the client draws it when the element mounts, so the consuming page
    /// needs no JavaScript of its own. Because mounting is what triggers the draw, the map is redrawn
    /// whenever the element is re-inserted into the document — which is what makes it survive an htmx
    /// swap.
    /// </para>
    /// <para>
    /// The payload is data only: coordinates, weights and labels. Nothing in it is evaluated on the
    /// client, so a page carrying a map needs no <c>unsafe-eval</c> in its Content-Security-Policy. Tiles
    /// are fetched as images from the basemap's host, which a strict <c>img-src</c> must allow.
    /// </para>
    /// <para>
    /// Leave this null to drive the map imperatively instead
    /// (<c>window.raptorMap(id).render(model)</c>).
    /// </para>
    /// </summary>
    [Parameter]
    public RaptorMapModel? Model { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Effective state: the explicit one, or the slot-derived default when none was given.</summary>
    private RaptorState Current => State ?? (Loading is not null ? RaptorState.Loading : RaptorState.Content);

    private string? CanvasStyle => Height is null ? null : $"min-height:{Height}";

    private string? ModelJson => Model is null ? null : RaptorMapData.Serialize(Model);
}
