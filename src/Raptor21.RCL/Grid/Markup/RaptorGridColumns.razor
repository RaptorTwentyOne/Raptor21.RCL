@typeparam TRow
@attribute [Microsoft.AspNetCore.Components.CascadingTypeParameter(nameof(TRow))]
@using Microsoft.AspNetCore.Components
@using Raptor21.RCL.Grid
@inject RaptorMarkupGridSink Sink

<CascadingValue TValue="RaptorColumnCollector<TRow>" Value="_collector" IsFixed="true">@ChildContent</CascadingValue>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Stable DOM id for the grid region (form / scroll container ids derive from it).</summary>
    [Parameter] public string Id { get; set; } = "grid";

    [Parameter] public int PageSize { get; set; } = 25;
    [Parameter] public int[]? PageSizeOptions { get; set; }
    [Parameter] public bool MasterDetail { get; set; }
    [Parameter] public string? DetailUrl { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool Selectable { get; set; }
    [Parameter] public bool VirtualScroll { get; set; }
    [Parameter] public string? Include { get; set; }
    [Parameter] public string? ViewPermission { get; set; }
    [Parameter] public string? EditPermission { get; set; }
    [Parameter] public bool DeferInitialLoad { get; set; }

    private readonly RaptorColumnCollector<TRow> _collector = new();

    protected override void OnInitialized()
    {
        Sink.Collector = _collector;
        Sink.Config = new GridViewConfig(
            Id,
            PageSize,
            PageSizeOptions ?? new[] { 25, 50, 100 },
            MasterDetail,
            DetailUrl,
            Compact,
            Selectable,
            VirtualScroll,
            Include,
            ViewPermission,
            EditPermission,
            DeferInitialLoad);
    }
}
