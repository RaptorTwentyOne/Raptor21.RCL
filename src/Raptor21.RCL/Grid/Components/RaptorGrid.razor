@typeparam TRow
@attribute [CascadingTypeParameter(nameof(TRow))]
@using Raptor21.RCL.Grid

<CascadingValue TValue="RaptorGridColumnCollector<TRow>" Value="_collector" IsFixed="true">
    @ChildContent
    <RaptorGridRegion TRow="TRow"
                      Collector="_collector"
                      ItemsProvider="ItemsProvider"
                      RowKey="RowKey"
                      Id="@Id"
                      Handler="@Handler"
                      PageSize="PageSize"
                      PageSizeOptions="PageSizeOptions"
                      Compact="Compact"
                      Include="@Include"
                      ViewPermission="@ViewPermission"
                      EditPermission="@EditPermission"
                      FilterEntry="FilterEntry"
                      DeferInitialLoad="DeferInitialLoad"
                      VirtualScroll="VirtualScroll"
                      RowReorder="RowReorder"
                      MasterDetail="MasterDetail"
                      DetailUrl="@DetailUrl"
                      Card="Card"
                      CardTemplate="CardTemplate"
                      Endpoint="@Endpoint"/>
</CascadingValue>

@code {
    /// <summary>
    /// The &lt;RaptorColumn&gt; children. They register themselves with the cascaded column collector as they
    /// render, so the region that consumes the collector is rendered after this fragment and inside the same
    /// cascade — reordering the two would leave the region reading an empty collector.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Fetches one page for the current filter/sort/paging state (the page's data access).</summary>
    [Parameter]
    [EditorRequired]
    public Func<GridQueryState, string?, CancellationToken, Task<GridPage<TRow>>> ItemsProvider { get; set; } = default!;

    /// <summary>Stable identity for a row (selection, master-detail, row swaps).</summary>
    [Parameter]
    [EditorRequired]
    public Func<TRow, string> RowKey { get; set; } = default!;

    /// <summary>Stable DOM id for the grid region (form / scroll container ids derive from it).</summary>
    [Parameter]
    public string Id { get; set; } = "grid";

    /// <summary>The page handler this grid posts to (OnPost{Handler}Async). Default "Grid".</summary>
    [Parameter]
    public string Handler { get; set; } = "Grid";

    [Parameter] public int PageSize { get; set; } = 25;
    [Parameter] public int[] PageSizeOptions { get; set; } = [25, 50, 100];
    [Parameter] public bool Compact { get; set; }
    [Parameter] public string? Include { get; set; }
    [Parameter] public string? ViewPermission { get; set; }
    [Parameter] public string? EditPermission { get; set; }

    /// <summary>Where the card-mode filter drawer is opened from: the grid's own floating action button
    /// (default) or the page shell's "…" menu. <see cref="RaptorGridFilterEntry.PageChrome"/> expects the
    /// page to render a <c>&lt;RaptorGridFilterButton For="@Id"/&gt;</c>; without it the FAB stays.</summary>
    [Parameter] public RaptorGridFilterEntry FilterEntry { get; set; } = RaptorGridFilterEntry.Fab;

    /// <summary>When true (default), skips fetching data on the initial GET render so the page shell ships immediately;
    /// the grid then loads its first page via its own load POST, showing skeleton rows until data arrives.</summary>
    [Parameter]
    public bool DeferInitialLoad { get; set; } = true;

    /// <summary>Continuous (infinite) scroll instead of the pager: the region appends row blocks as the
    /// user nears the end of the loaded rows and the footer shows "Loaded N of M" instead of page controls.</summary>
    [Parameter]
    public bool VirtualScroll { get; set; }

    /// <summary>Drag-and-drop row reordering: a leading drag-handle cell per row. Requires an
    /// <see cref="Endpoint"/>-relative <c>/reorder</c> route (or an <c>OnPost{Handler}ReorderAsync</c>
    /// page handler) that persists the move and re-renders the region.</summary>
    [Parameter]
    public bool RowReorder { get; set; }

    /// <summary>Expandable master-detail rows: a leading expand toggle per row that htmx-fetches <see cref="DetailUrl"/>.</summary>
    [Parameter]
    public bool MasterDetail { get; set; }

    /// <summary>Detail URL template (with <c>{key}</c>, replaced by the row key) fetched into the expanded row.</summary>
    [Parameter]
    public string? DetailUrl { get; set; }

    /// <summary>Custom mobile card renderer. When set, each row also carries a card cell the grid shows (in place
    /// of the columns) when it folds to cards on narrow viewports.</summary>
    [Parameter]
    public Func<TRow, GridCell>? Card { get; set; }

    /// <summary>Markup-based mobile card renderer — the declarative sibling of <see cref="Card"/>. When set, it
    /// takes priority over <see cref="Card"/> and renders as ordinary component markup instead of an HTML string.</summary>
    [Parameter]
    public RenderFragment<TRow>? CardTemplate { get; set; }

    /// <summary>Explicit htmx POST target for the grid. Leave null on a Razor Page (posts to ?handler); set
    /// it to a minimal-API route when hosting the grid on a routable .razor page, which has no page handler.</summary>
    [Parameter]
    public string? Endpoint { get; set; }

    private readonly RaptorGridColumnCollector<TRow> _collector = new();
}
