@using Raptor21.RCL.Localization
@typeparam TRow
@using System.Globalization
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Primitives
@using Raptor21.RCL.Grid
@inherits Raptor21.RCL.Rendering.RaptorSequentialComponent
@inject RaptorGridBuilder Builder
@inject IRaptorLocalizer L
@inject IHttpContextAccessor HttpAccessor

@{
    var prepared = _prepared;
}
@if (prepared is not null)
{
    var columns = prepared.Columns;
    var state = prepared.State;
    var pageSize = state.PageSize <= 0 ? PageSize : state.PageSize;
    var totalPages = pageSize == 0 ? 1 : Math.Max(1, (int)Math.Ceiling(prepared.TotalCount / (decimal)pageSize));
    var sort = state.Sorts.FirstOrDefault();
    var sortField = sort?.ColumnName;
    var sortDir = sort?.Direction == GridSortDirection.Descending ? "desc" : "asc";
    var pageNo = state.Page;
    var from = prepared.TotalCount == 0 ? 0 : (state.Page - 1) * pageSize + 1;
    var to = Math.Min(state.Page * pageSize, prepared.TotalCount);
    var prevDisabled = pageNo <= 1;
    var nextDisabled = pageNo >= totalPages;
    var hasDetail = MasterDetail && !string.IsNullOrEmpty(DetailUrl);
    var hasCards = Card is not null || CardTemplate is not null;
    var spanCols = columns.Count + (hasDetail ? 1 : 0) + (RowReorder ? 1 : 0);
    var tableMinWidth = columns.Sum(c => c.MinWidth ?? c.Width ?? 130) + (hasDetail ? 40 : 0) + (RowReorder ? 40 : 0);
    // Row DnD is only honest against the stored order: under a non-default sort or an active filter the
    // visible neighbours are not the stored neighbours, so a drop position has no defensible meaning.
    // The handle cell still renders (the column must not appear and vanish with filter state) but in a
    // disabled look — decided HERE, on the server, so the client needs no guard of its own.
    var reorderOff = state.Sorts.Count > 0 || state.Filters.Count > 0;
    // Virtual scroll: another block exists while the loaded prefix (page * pageSize) hasn't covered the
    // total. The footer label states that same prefix; VirtualScroll.ts restates it from the DOM after
    // every append.
    var hasMoreBlocks = VirtualScroll && state.Page * pageSize < prepared.TotalCount;
    var loadedCount = Math.Min(state.Page * pageSize, prepared.TotalCount);
    var popupColumns = columns.Where(HasPopup).ToList();
    var formId = $"{Id}-form";
    var regionId = $"{Id}-region";
    var gridClass = "raptor-grid" + (hasCards ? " rg-has-cards" : "") + (Compact ? " rg-compact" : "");

    // The mark that hands the drawer's opener to the page shell. SERVER-RENDERED, on purpose: the two
    // rules it gates (hide the FAB, drop the footer reservation the FAB needs) change the footer's height
    // by 60px, so a mark applied from script after the swap would repaint the region once with the FAB
    // and once without — a measured 60px shift on every page/filter change. Rendered here it arrives in
    // the same markup as the rows and nothing ever shifts.
    // Only when there is something to open: a grid with no filterable column renders no drawer and no FAB.
    var filterEntryMark = FilterEntry == RaptorGridFilterEntry.PageChrome && popupColumns.Count > 0 ? "" : null;

    // ONE code path renders data rows for both answers this component can give — the full region, and
    // (on a sentinel's block post) just this page's rows. A local fragment closing over the prepared
    // locals above, rather than duplicated markup or a parameter-plumbed method.
    RenderFragment dataRows = @<text>
        @foreach (var row in prepared.Rows)
        {
            var rowKey = RowKey(row);
            var detailId = $"{Id}-detail-{rowKey}";
            var detailKey = rowKey + "-detail";
            <tr data-row-key="@rowKey" @key="rowKey">
                @if (RowReorder)
                {
                    <td class="rg-drag">
                        <button type="button" class="rg-drag-handle @(reorderOff ? "rg-drag-off" : null)"
                                data-rg-drag="@(reorderOff ? null : "")"
                                draggable="@(reorderOff ? null : "true")"
                                aria-label="Drag to reorder" aria-disabled="@(reorderOff ? "true" : null)"
                                title="@(reorderOff ? "Reordering is off while the grid is sorted or filtered" : "Drag to reorder")">
                            <span class="rg-ico rg-ico-drag"></span>
                        </button>
                    </td>
                }
                @if (hasDetail)
                {
                    <td class="rg-expand-cell">
                        <button type="button" class="rg-expand" data-rg-expand="@detailId"
                                data-rg-detail-url="@DetailUrl!.Replace("{key}", rowKey)"
                                aria-expanded="false" aria-label="@L["Grid_ExpandRow"]">
                            <span class="rg-ico rg-ico-chevron"></span>
                        </button>
                    </td>
                }
                @foreach (var col in columns)
                {
                    var alignCol = col.Align ?? (col.Filter == GridFilterType.Number ? "right" : null);
                    var editable = prepared.CanEdit && col.Editable && !string.IsNullOrEmpty(col.Editor);
                    <td data-rg-field="@col.Key" data-label="@col.Header"
                        class="@AlignClass(alignCol) @(col.Wrap ? "rg-wrap" : null) @(editable ? "rg-editable" : null) @col.CssClass"
                        data-rg-edit="@(editable ? col.Editor : null)">
                        @RenderCell(col, row)
                    </td>
                }
                @if (hasCards)
                {
                    <td class="rg-card" colspan="@spanCols">
                        @if (CardTemplate is not null)
                        {
                            @CardTemplate(row)
                        }
                        else
                        {
                            @((MarkupString)Card!(row).Html)
                        }
                    </td>
                }
            </tr>
            @if (hasDetail)
            {
                <tr class="rg-detail-row" data-detail-row="@rowKey" hidden @key="detailKey">
                    <td colspan="@spanCols" class="rg-detail-cell">
                        <div id="@detailId" class="rg-detail">
                            <div class="rg-detail-loading">
                                <span class="rg-ico rg-ico-spinner rg-ico-spin"></span> Loading…
                            </div>
                        </div>
                    </td>
                </tr>
            }
        }
    </text>;

    // The sentinel row the next block arrives through. It lives INSIDE the region form, so the non-GET
    // post carries the form's whole state (filters, sort, colOrder, ctx_*) automatically; hx-vals then
    // overrides the form's own page with the next one and marks the request as a block request.
    // GridEndpoints.Block is deliberately NOT used: posting block=1 back to the REGION endpoint means
    // the host wires no extra handler — this component itself answers with rows + a new sentinel.
    // hx-target/hx-indicator override the form-inherited ones, which would otherwise re-swap the whole
    // region and dim every loaded row on each append.
    // hx-sync overrides the form-inherited "closest form:replace" with "abort": under replace, a
    // scroll-triggered block post racing a user's filter/sort post would CANCEL the user's request and
    // append rows of the stale state — the user's typed filter would silently do nothing. With abort the
    // automatic request yields both ways: it is dropped while a user request is in flight and aborted
    // when one starts. Either winner re-swaps the region (fresh sentinel), and a failed winner re-arms
    // the observer through VirtualScroll's unsuccessful-request path, so scrolling never stalls.
    RenderFragment? sentinel = null;
    if (hasMoreBlocks)
    {
        sentinel = @<tr data-rg-sentinel aria-hidden="true"
                       hx-post="@_endpoints.Region"
                       hx-trigger="sgload"
                       hx-target="this"
                       hx-swap="outerHTML"
                       hx-indicator="this"
                       hx-sync="closest form:abort"
                       hx-vals="@($"{{\"page\":\"{state.Page + 1}\",\"block\":\"1\"}}")">
            <td colspan="@spanCols"></td>
        </tr>;
    }

    if (_block)
    {
        <text>@dataRows@sentinel</text>
    }
    else
    {
    <div id="@regionId" data-rg-component="grid" class="@gridClass"
         data-grid-id="@Id" data-rg-virtual="@(VirtualScroll ? "true" : "false")" data-rg-total="@prepared.TotalCount"
         data-rg-fit="@(FitViewport ? null : "false")"
         data-rg-filter-entry="@filterEntryMark"
         data-rg-reorder-endpoint="@(RowReorder ? _endpoints.Reorder : null)"
         data-rg-cell-endpoint="@_endpoints.Cell">
        <form id="@formId"
              class="rg-form"
              hx-post="@_endpoints.Region"
              hx-target="#@regionId"
              hx-swap="outerHTML"
              hx-indicator="#@regionId"
              hx-include="@(string.IsNullOrWhiteSpace(Include) ? $"#{formId}" : $"#{formId}, {Include}")"
              hx-sync="closest form:replace"
              hx-trigger="@(_deferred ? "load, raptor:refresh" : "raptor:refresh")"
              autocomplete="off">

            <input type="hidden" name="page" value="@state.Page"/>
            <input type="hidden" name="sort" value="@(sortField ?? string.Empty)"/>
            <input type="hidden" name="dir" value="@sortDir"/>
            <input type="hidden" name="colOrder" value="@string.Join(",", columns.Where(c => c.Pinned is null).Select(c => c.Key))"/>
            @foreach (var kv in state.Params)
            {
                <input type="hidden" name="ctx_@kv.Key" value="@kv.Value"/>
            }

            @* ---- THE SCOPE LINE ----------------------------------------------------------------
               WHAT THIS READING COVERS, in words, above the table it covers.

               Before this, a filtered grid announced itself with ONE signal: the funnel glyph changed
               from the foreground colour to the accent. Same glyph, same size, no count, no dot. Measured
               on a consuming page at 3.12:1 against its surround -- barely over the 3:1 non-text floor --
               and invisible to anyone who does not know the unfiltered colour by heart. A person who
               leaves the tab and comes back cannot tell 32,341 rows from 14.

               IT STATES THE FILTERS AND NOT THE COUNT. The pager already prints the range and the total,
               and it prints the SERVER's numbers; a second element computing its own count is how a
               footer ends up disagreeing with the query behind it. So this says what narrowed the
               reading, the pager says how much is left, and neither repeats the other.

               EACH CHIP REMOVES ITS OWN FILTER, and the remove button carries `data-rg-clear="<key>"` --
               the same attribute the popup's own "Clear filter" button uses, handled by the same code in
               FilterPopups.ts. A chip is a second way to reach one behaviour, not a second behaviour.

               Rendered only when something is actually filtered: an unfiltered grid is not narrowed, and
               a line saying so every time is the kind of chrome people stop reading. *@
            @{
                var scopeChips = columns
                    .Where(c => _filterValues.ContainsKey(c.Key) || _setSelections.ContainsKey(c.Key))
                    .Select(c =>
                    {
                        var isSet = _setSelections.TryGetValue(c.Key, out var picked);
                        var op = isSet ? string.Empty : OpLabel(c, _filterOps.GetValueOrDefault(c.Key));
                        return new
                        {
                            c.Key,
                            // The column and the operator are ONE phrase: "Country:" or "Customer Code
                            // starts with". Splitting the operator into its own node put a space before
                            // the colon -- "Country : TR" -- which is the kind of detail that makes a
                            // whole surface look unfinished.
                            Term = op.Length == 0 ? $"{c.Header}:" : $"{c.Header} {op}",
                            // A set filter stores VALUES ("true", a Guid); the chip has to print the
                            // LABEL the user ticked. Shown live as `Order Blockage: true` before this --
                            // the chip repeating the wire format back at the person who chose "Blocked".
                            Value = isSet
                                ? (picked!.Count == 1 ? SetLabel(c, picked.First()) : L.Format("Grid_ScopeSelected", L.Number(picked.Count)))
                                : _filterValues.GetValueOrDefault(c.Key) ?? string.Empty,
                            c.Header
                        };
                    })
                    .ToList();
            }
            @if (scopeChips.Count > 0)
            {
                <div class="rg-scope">
                    <span class="rg-scope-label">@L["Grid_ScopeFilteredBy"]</span>
                    @foreach (var chip in scopeChips)
                    {
                        <span class="rg-scope-chip">
                            <span class="rg-scope-chip-col">@chip.Term</span>
                            <span class="rg-scope-chip-val">@chip.Value</span>
                            <button type="button" class="rg-scope-chip-x" data-rg-clear="@chip.Key"
                                    aria-label="@L.Format("Grid_ScopeRemoveFilter", chip.Header)">
                                <span class="rg-ico rg-ico-close" aria-hidden="true"></span>
                            </button>
                        </span>
                    }
                    <button type="button" class="rg-scope-clear" data-rg-scope-clearall>@L["Filter_ClearAll"]</button>
                </div>
            }

            @* FOCUSABLE ON PURPOSE. Chrome only auto-focuses a scroll container that has NO focusable
               children; this one has a sort button in most headers, so it never entered the tab order and
               a keyboard user could not scroll it. Columns whose cells contain no links -- dates, counts,
               plain text -- were therefore unreachable: measured 577px of table hidden on a real page.
               tabindex + role + name is the standard scrollable-region remedy. *@
            <div id="@(Id)-scroll" class="rg-scrollwrap" tabindex="0" role="region" aria-label="@L["Grid_ScrollRegion"]">
                <table style="min-width:@(tableMinWidth)px">
                    <colgroup>
                        @if (RowReorder)
                        {
                            <col class="rg-col-drag"/>
                        }
                        @if (hasDetail)
                        {
                            <col class="rg-col-expand"/>
                        }
                        @foreach (var col in columns)
                        {
                            var min = col.MinWidth ?? 80;
                            var initial = col.Width ?? (col.Flex is { } f ? Math.Max(f * 140, min) : Math.Max(160, min));
                            <col data-rg-col="@col.Key" data-rg-min="@min"
                                 data-rg-w="@(col.Width?.ToString() ?? "")"
                                 data-rg-flex="@(col.Width is null ? (col.Flex ?? 1).ToString() : "")"
                                 data-rg-pinned="@(col.Pinned ?? "")"
                                 style="width:@(initial)px"/>
                        }
                    </colgroup>
                    <thead>
                    <tr class="rg-head">
                        @if (RowReorder)
                        {
                            <th class="rg-drag" aria-hidden="true"></th>
                        }
                        @if (hasDetail)
                        {
                            <th class="rg-expand-cell" aria-hidden="true"></th>
                        }
                        @foreach (var col in columns)
                        {
                            var isSorted = string.Equals(col.Key, sortField, StringComparison.OrdinalIgnoreCase);
                            var nextDir = isSorted && sortDir == "asc" ? "desc" : "asc";
                            var isActive = _filterValues.ContainsKey(col.Key) || _setSelections.ContainsKey(col.Key);
                            var reorderable = col.Pinned is null;
                            var resizable = col.Pinned != "right";
                            var sortable = col.IsBound && col.Sortable;
                            var thStyle = col.Width is { } w ? $"width:{w}px" : col.MinWidth is { } mw ? $"min-width:{mw}px" : null;
                            @* aria-sort states the CURRENT sort; the button below states what a click
                               will DO. Split that way on purpose: a screen-reader user asking "how is this
                               table sorted" is asking the column, and a user deciding whether to press is
                               asking the control. Omitted (not "none") on unsorted columns, which is what
                               the spec's default already means. *@
                            <th scope="col" data-rg-col="@col.Key"
                                aria-sort="@(isSorted ? (sortDir == "asc" ? "ascending" : "descending") : null)"
                                class="@AlignClass(col.Align ?? (col.Filter == GridFilterType.Number ? "right" : null)) @(reorderable ? "rg-reorder" : null) @col.CssClass"
                                draggable="@(reorderable ? "true" : "false")"
                                data-rg-min="@(resizable ? (col.MinWidth ?? 60).ToString() : null)"
                                style="@thStyle">
                                <div class="rg-hd">
                                    @if (sortable)
                                    {
                                        <button type="button" class="rg-sort" hx-post="@_endpoints.Region"
                                                hx-vals="@($"{{\"sort\":\"{col.Key}\",\"dir\":\"{nextDir}\",\"page\":\"1\"}}")">
                                            @* The visible label stays the START of the accessible name, so
                                               voice control ("click Customer Code") still matches, and the
                                               action is appended for anyone who cannot see the arrow.
                                               The two spans are ADJACENT in source on purpose: a newline
                                               between them becomes a text node and the name comes out as
                                               "Customer Code , sort ascending" with a space before the
                                               comma, which accessible-name computation collapses but does
                                               not remove. *@
                                            <span>@col.Header</span><span class="rg-sr-only">, @(nextDir == "asc" ? L["Grid_SortAscending"] : L["Grid_SortDescending"])</span>
                                            @if (isSorted)
                                            {
                                                <span class="rg-ico rg-arrow @(sortDir == "asc" ? "rg-ico-sort-asc" : "rg-ico-sort-desc")"></span>
                                            }
                                            else
                                            {
                                                <span class="rg-ico rg-arrow-idle rg-ico-sort"></span>
                                            }
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="rg-title">@col.Header</span>
                                    }
                                    @if (HasPopup(col))
                                    {
                                        <button type="button" class="rg-funnel @(isActive ? "active" : "")" data-rg-toggle="@col.Key" aria-label="Filter @col.Header" title="Filter"
                                                aria-haspopup="true" aria-expanded="false" aria-controls="@(Id)-pop-@col.Key">
                                            <span class="rg-ico rg-ico-filter"></span>
                                        </button>
                                    }
                                </div>
                                @if (resizable)
                                {
                                    <span class="rg-resize" data-rg-resize></span>
                                }
                            </th>
                        }
                    </tr>
                    </thead>
                    <tbody>
                    @if (_deferred)
                    {
                        @for (var i = 0; i < Math.Min(pageSize, 12); i++)
                        {
                            <tr class="rg-skeleton-row" aria-hidden="true">
                                @if (RowReorder)
                                {
                                    <td class="rg-drag"></td>
                                }
                                @if (hasDetail)
                                {
                                    <td class="rg-expand-cell"></td>
                                }
                                @for (var c = 0; c < columns.Count; c++)
                                {
                                    <td><span class="rg-skeleton rg-skeleton-bar @SkeletonWidthClass(c)"></span></td>
                                }
                            </tr>
                        }
                    }
                    else if (prepared.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="@spanCols" class="rg-empty">
                                <span class="rg-ico rg-ico-empty rg-empty-icon"></span>
                                <div class="rg-empty-title">@L["Grid_NoRecords"]</div>
                                <div class="rg-empty-hint">@(state.Filters.Count > 0 ? L["Grid_NoRecordsFiltered"] : L["Grid_NoRecordsEmpty"])</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @dataRows
                        @sentinel
                    }
                    </tbody>
                </table>
            </div>

            @if (popupColumns.Count > 0)
            {
                var activeFilters = _filterValues.Keys.Concat(_setSelections.Keys).Distinct(StringComparer.OrdinalIgnoreCase).Count();
                var drawerId = $"{Id}-filter-drawer";
                @* THE FAB CARRIES `popover="manual"` AND `MobileFilterDrawer` SHOWS IT AT MOUNT.

                   It is `position: fixed` bottom-right and it lives inside the consumer's pushed content
                   column, which becomes a CONTAINING BLOCK for its fixed descendants the moment
                   RaptorSidebar's Push mode puts a `translate` on it. Measured on /roles at 500x823 before
                   this attribute existed: FAB at rest [395,663,84,44], and on the FIRST frame of the rail
                   opening [395.2,719] — 56px down (the pushed box's own top offset) in one frame, before
                   any horizontal movement. The top layer is the only place a fixed box is guaranteed to
                   resolve against the VIEWPORT whatever its ancestors do.

                   `manual`, not `auto`: an `auto` popover is light-dismissed by the first tap anywhere and
                   closes when another `auto` opens — the drawer below is one. A `manual` popover neither
                   dismisses nor is dismissed, and it is the same mechanism the toast stack uses.

                   IT DEGRADES. Card mode sets `display: inline-flex` on the FAB at (0,3,0), which beats the
                   UA's `[popover]:not(:popover-open) { display: none }` on origin, so a FAB whose script
                   never arrived is still visible and still opens the drawer — it just keeps the old
                   containing-block behaviour until the grid chunk mounts. *@
                <button type="button" class="rg-filter-fab" popover="manual"
                        data-rg-filter-open aria-controls="@drawerId" aria-expanded="false"
                        aria-label="@L["Grid_OpenFilters"]">
                    <span class="rg-ico rg-ico-filter"></span><span>@L["Grid_Filter"]</span>
                    @if (activeFilters > 0)
                    {
                        <span class="rg-filter-count">@activeFilters</span>
                    }
                </button>
                @* THE DRAWER IS A TOP-LAYER SHELL, NOT THE SLIDING SURFACE ITSELF.

                   `popover="auto"` buys the two things the class-driven version never had: Escape closes it
                   (measured before: a real Escape left `drawerVisible=true` and `body { overflow: hidden }`
                   still held), and its containing block is the viewport, so a rail opening underneath it
                   can no longer stretch it (measured before: [140,0,360,723] -> [375,56,360,2519], right
                   edge 735 on a 500px viewport).

                   THREE ELEMENTS, NOT ONE, AND THAT IS WHAT KEEPS THE GEOMETRY HONEST. The shell is fixed,
                   full-viewport and carries NO transform; `.rg-filter-backdrop` is the scrim and
                   `.rg-filter-panel` is the surface that slides. Putting the slide on the shell would make
                   the shell a containing block for its own fixed scrim — the mistake `_sidebar.scss` §3c
                   documents having measured (the scrim came out the RAIL's width, 240 instead of 390) and
                   had to work around with viewport units plus a counter-translate. With the transform one
                   level in, the scrim is a plain `position: fixed; inset: 0` again.

                   THE SCRIM IS A DOM DESCENDANT, like the rail's. A popover's `::backdrop` is not
                   hit-testable (measured in `runtime/sidebar.ts`), so the dismissal tap would fall through
                   to whatever page control sat under it. Being inside the popover also means the UA's
                   light-dismiss never fires — every tap is an INSIDE tap — which is why the scrim carries
                   `data-rg-filter-close` and `MobileFilterDrawer` closes it explicitly. *@
                <div class="rg-filter-drawer" id="@drawerId" popover="auto">
                    <div class="rg-filter-backdrop" data-rg-filter-close></div>
                    <div class="rg-filter-panel">
                    <div class="rg-filter-head"><span>@L["Grid_Filters"]</span>
                        <button type="button" class="rg-filter-x" data-rg-filter-close aria-label="@L["Grid_CloseFilters"]">
                            <span class="rg-ico rg-ico-close"></span></button>
                    </div>
                    <div class="rg-filter-body">
                        @foreach (var col in popupColumns)
                        {
                            <div class="rg-pop" id="@(Id)-pop-@col.Key" data-rg-pop="@col.Key" hx-preserve="true">
                                <div class="rg-pop-label">@col.Header</div>
                                @if (col.Filter == GridFilterType.Set)
                                {
                                    var selected = _setSelections.TryGetValue(col.Key, out var sel) ? sel : (IReadOnlyCollection<string>)[];
                                    @* A long option list must be searchable (measured complaint: in a 40+
                                       option set the one wanted entry could only be found by scrolling).
                                       NEVER REACHES THE SERVER: no name (not serialised into the form), no
                                       hx attribute — FilterPopups filters the option labels client-side.
                                       The threshold exists because a search box over a handful of options
                                       is noise. Living inside the hx-preserve'd panel, the typed text
                                       survives region swaps. *@
                                    @if (col.SetOptions!.Count >= 8)
                                    {
                                        <input type="search" class="rg-pop-set-search" data-rg-set-search
                                               placeholder="Search…" autocomplete="off" aria-label="Search @col.Header options"/>
                                    }
                                    @* TWO VALUES MEANS ONE CHOICE. A boolean column has exactly two
                                       possible states, so ticking both is provably identical to no filter
                                       at all -- the control offers a combination that cannot mean
                                       anything. Marked here and enforced in FilterPopups.ts, where
                                       checking one unchecks the other; clicking the checked one again
                                       still clears it, which a radio group could not do.

                                       BOOLEAN ONLY, deliberately. A two-option TEXT set is not the same
                                       thing: its options can be a subset of the real domain (a user's two
                                       permitted sales organisations out of forty), and there selecting
                                       both is a genuine constraint. *@
                                    <div class="rg-pop-set" data-rg-set-exclusive="@(col.SetDataType == GridFilterDataType.Boolean && col.SetOptions!.Count == 2 ? "true" : null)">
                                        @foreach (var option in col.SetOptions!)
                                        {
                                            <label class="rg-pop-check">
                                                <input type="checkbox" name="fs_@col.Key" value="@option.Value" checked="@selected.Contains(option.Value)"
                                                       hx-post="@_endpoints.Region" hx-trigger="change" hx-vals='{"page":"1"}'/>
                                                <span>@option.Label</span>
                                            </label>
                                        }
                                    </div>
                                }
                                else
                                {
                                    var val = _filterValues.TryGetValue(col.Key, out var fv) ? fv : string.Empty;
                                    var curOp = _filterOps.TryGetValue(col.Key, out var op) ? op : GridFilterOps.DefaultKey(col.Filter);
                                    var inputType = col.Filter == GridFilterType.Number ? "number" : col.Filter == GridFilterType.Date ? "date" : "text";
                                    <select name="fop_@col.Key" class="rg-pop-op" hx-post="@_endpoints.Region" hx-trigger="change" hx-vals='{"page":"1"}'>
                                        @foreach (var (key, label) in GridFilterOps.Options(col.Filter))
                                        {
                                            <option value="@key" selected="@(key == curOp)">@label</option>
                                        }
                                    </select>
                                    <input name="f_@col.Key" type="@inputType" value="@val" class="rg-pop-input" placeholder="Filter…" autocomplete="off"
                                           hx-post="@_endpoints.Region" hx-trigger="@(col.Filter == GridFilterType.Date ? "change" : "input changed delay:400ms")" hx-vals='{"page":"1"}'/>
                                }
                                <div class="rg-pop-actions">
                                    <button type="button" class="rg-pop-clear" data-rg-clear="@col.Key">Clear filter
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="rg-filter-actions">
                        <button type="button" class="rg-pop-clear" data-rg-filter-clearall>Clear all</button>
                        <button type="button" class="rg-nav rg-filter-done" data-rg-filter-close>Done</button>
                    </div>
                    </div>
                </div>
            }

            <div class="rg-foot">
                @if (VirtualScroll)
                {
                    @* No page to pick and no size to choose in virtual mode: blocks share the grid's
                       PageSize and arrive on scroll, so the pager and the pageSize select give way to a
                       running count. VirtualScroll.ts restates this label from the rows actually in the
                       DOM after every append/swap — the wording and the en-US thousands separators here
                       deliberately match what it writes. *@
                    <span class="rg-nums" data-rg-loaded>Loaded @loadedCount.ToString("N0", CultureInfo.InvariantCulture) of @prepared.TotalCount.ToString("N0", CultureInfo.InvariantCulture)</span>
                }
                else
                {
                @* A <label> wrapping the control, not a floating <span>: no id to generate, no id to
                   collide with a second grid on the same page, and the association cannot drift. *@
                <label class="rg-foot-cell">
                    <span>Page Size:</span>
                    <select name="pageSize" class="rg-select" hx-post="@_endpoints.Region" hx-trigger="change" hx-vals='{"page":"1"}'>
                        @foreach (var size in PageSizeOptions)
                        {
                            <option value="@size" selected="@(size == state.PageSize)">@size</option>
                        }
                    </select>
                </label>

                @* The one line that says how much data you are looking at, so it is the one line worth
                   announcing when a filter or a page changes it. LIMIT, stated honestly: htmx swaps this
                   whole region, so the live region is re-inserted rather than mutated, and assistive
                   technologies differ on whether they announce that. It is a real improvement over zero
                   live regions and it is not a guarantee; a stable node outside the swap would be. *@
                <span class="rg-nums" role="status">@L.Format("Grid_Range", L.Number(from), L.Number(to), L.Number(prepared.TotalCount))</span>

                <div class="rg-pager">
                    <button type="button" class="rg-nav" title="@L["Grid_FirstPage"]" disabled="@prevDisabled" hx-post="@_endpoints.Region" hx-vals='{"page":"1"}'>
                        <span class="rg-ico rg-ico-first"></span>
                    </button>
                    <button type="button" class="rg-nav" title="@L["Grid_PreviousPage"]" disabled="@prevDisabled" hx-post="@_endpoints.Region" hx-vals="@($"{{\"page\":\"{pageNo - 1}\"}}")">
                        <span class="rg-ico rg-ico-prev"></span>
                    </button>
                    <span class="rg-nums rg-pageinfo">@L.Format("Grid_PageInfo", L.Number(pageNo), L.Number(totalPages))</span>
                    <button type="button" class="rg-nav" title="@L["Grid_NextPage"]" disabled="@nextDisabled" hx-post="@_endpoints.Region" hx-vals="@($"{{\"page\":\"{pageNo + 1}\"}}")">
                        <span class="rg-ico rg-ico-next"></span>
                    </button>
                    <button type="button" class="rg-nav" title="@L["Grid_LastPage"]" disabled="@nextDisabled" hx-post="@_endpoints.Region" hx-vals="@($"{{\"page\":\"{totalPages}\"}}")">
                        <span class="rg-ico rg-ico-last"></span>
                    </button>
                </div>
                }
            </div>
        </form>
    </div>
    }
}

@code {
    [Parameter, EditorRequired] public RaptorGridColumnCollector<TRow> Collector { get; set; } = default!;
    [Parameter, EditorRequired] public Func<GridQueryState, string?, CancellationToken, Task<GridPage<TRow>>> ItemsProvider { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TRow, string> RowKey { get; set; } = default!;

    [Parameter] public string Id { get; set; } = "grid";
    [Parameter] public string Handler { get; set; } = "Grid";
    [Parameter] public int PageSize { get; set; } = 25;
    [Parameter] public int[] PageSizeOptions { get; set; } = [25, 50, 100];
    [Parameter] public bool Compact { get; set; }
    [Parameter] public string? Include { get; set; }
    [Parameter] public string? ViewPermission { get; set; }
    [Parameter] public string? EditPermission { get; set; }

    /// <summary>Where the card-mode filter drawer is opened from. See <see cref="RaptorGridFilterEntry"/>.</summary>
    [Parameter] public RaptorGridFilterEntry FilterEntry { get; set; } = RaptorGridFilterEntry.Fab;

    /// <summary>When true (default), skips fetching data on the initial GET render so the page shell ships immediately;
    /// the grid then loads its first page via its own load POST, showing skeleton rows until data arrives.</summary>
    [Parameter]
    public bool DeferInitialLoad { get; set; } = true;

    /// <summary>Continuous (infinite) scroll instead of the pager: a sentinel row appends the next block
    /// as the user nears the end, and the footer shows a "Loaded N of M" count.</summary>
    [Parameter]
    public bool VirtualScroll { get; set; }

    /// <summary>See <see cref="RaptorGrid{TRow}.FitViewport"/>. Rendered as <c>data-rg-fit="false"</c> only when off.</summary>
    [Parameter]
    public bool FitViewport { get; set; } = true;

    /// <summary>Drag-and-drop row reordering: a leading handle cell per row; drops post to the grid's
    /// <c>/reorder</c> endpoint (Razor Pages: <c>OnPost{Handler}ReorderAsync</c>).</summary>
    [Parameter]
    public bool RowReorder { get; set; }

    /// <summary>Expandable master-detail rows: a leading expand toggle per row that htmx-fetches <see cref="DetailUrl"/>.</summary>
    [Parameter]
    public bool MasterDetail { get; set; }

    /// <summary>Detail URL template (with <c>{key}</c>) fetched into the expanded row on first expand.</summary>
    [Parameter]
    public string? DetailUrl { get; set; }

    /// <summary>Custom mobile card renderer; when set, each row also carries a full-width card cell (shown when
    /// the grid folds to cards on narrow viewports).</summary>
    [Parameter]
    public Func<TRow, GridCell>? Card { get; set; }

    /// <summary>Markup-based mobile card renderer — the declarative sibling of <see cref="Card"/>. When set, it
    /// takes priority over <see cref="Card"/> and renders as ordinary component markup instead of an HTML string.</summary>
    [Parameter]
    public RenderFragment<TRow>? CardTemplate { get; set; }

    /// <summary>Explicit htmx POST target. When null the grid posts to its owning page's ?handler={Handler}
    /// (Razor Pages). A routable .razor page has no such handler, so it passes a minimal-API route here.</summary>
    [Parameter]
    public string? Endpoint { get; set; }

    private PreparedGrid<TRow>? _prepared;
    private GridEndpoints _endpoints;
    private bool _deferred;
    private bool _block;
    private Dictionary<string, RaptorColumnSpec<TRow>> _specByKey = new(StringComparer.OrdinalIgnoreCase);
    /// <summary>
    /// The operator as a word, for a scope chip. Falls back to the raw key rather than to a guess: an
    /// unknown operator printed verbatim is odd, and an operator silently shown as "contains" is wrong.
    /// The default operator prints nothing at all -- "Customer Code contains ZZZ" reads as a sentence,
    /// "Country equals TR" does not read better than "Country: TR".
    /// </summary>
    /// <summary>
    /// The label a set option was offered under, for a scope chip. Falls back to the raw value when the
    /// options cannot be resolved — a Guid in a chip is unhelpful but honest, and inventing a word for it
    /// would be worse.
    /// </summary>
    private static string SetLabel(GridColumn<TRow> column, string value) =>
        column.SetOptions?.FirstOrDefault(o => string.Equals(o.Value, value, StringComparison.OrdinalIgnoreCase))?.Label ?? value;

    private static string OpLabel(GridColumn<TRow> column, string? opKey)
    {
        var key = string.IsNullOrEmpty(opKey) ? GridFilterOps.DefaultKey(column.Filter) : opKey;
        if (string.Equals(key, GridFilterOps.DefaultKey(column.Filter), StringComparison.OrdinalIgnoreCase))
            return string.Empty;
        var match = GridFilterOps.Options(column.Filter).FirstOrDefault(o => string.Equals(o.Key, key, StringComparison.OrdinalIgnoreCase));
        return (match.Label ?? key).ToLowerInvariant();
    }

    private IReadOnlyDictionary<string, string> _filterValues = new Dictionary<string, string>();
    private IReadOnlyDictionary<string, string> _filterOps = new Dictionary<string, string>();
    private IReadOnlyDictionary<string, IReadOnlyCollection<string>> _setSelections = new Dictionary<string, IReadOnlyCollection<string>>();

    protected override async Task OnInitializedAsync()
    {
        var http = HttpAccessor.HttpContext ?? throw new InvalidOperationException("<RaptorGrid> needs an active HttpContext (server render).");

        _specByKey = Collector.Specs.ToDictionary(s => s.Column.Key, StringComparer.OrdinalIgnoreCase);

        var view = new GridView<TRow>
        {
            Id = Id,
            Columns = [.. Collector.Specs.Select(s => s.Column)],
            PageSize = PageSize,
            PageSizeOptions = PageSizeOptions,
            Include = Include,
            Compact = Compact,
            ViewPermission = ViewPermission,
            EditPermission = EditPermission,
            DeferInitialLoad = DeferInitialLoad,
            VirtualScroll = VirtualScroll,
        };

        _deferred = DeferInitialLoad && HttpMethods.IsGet(http.Request.Method);
        if (Endpoint is { Length: > 0 } ep)
        {
            _endpoints = GridEndpoints.FromBase(ep);
        }
        else
        {
            _endpoints = GridEndpoints.ForPageHandlers(http.Request.Path.Value ?? string.Empty, Handler);
        }

        IEnumerable<KeyValuePair<string, StringValues>> request =
            http.Request.HasFormContentType ? http.Request.Form : http.Request.Query;

        // A sentinel's block post: answer with ONLY the requested page's rows (+ the next sentinel)
        // instead of the whole region — the markup's outermost branch. Recognised from a form field
        // rather than a dedicated route (GridEndpoints.Block is deliberately unused for this): the
        // sentinel posts the region form itself, so filter/sort/colOrder state rides along for free and
        // the host wires no extra handler.
        _block = VirtualScroll
                 && http.Request.HasFormContentType
                 && http.Request.Form["block"] == "1";

        var source = new DelegateGridSource<TRow>(view, ItemsProvider, RowKey);
        // The non-acquiring entry: this lifecycle (RaptorSequentialComponent) already holds the render
        // gate, and the gate is deliberately non-reentrant.
        _prepared = await Builder.PrepareUnderCallerGateAsync(source, request, http.RequestAborted, _deferred);
        (_filterValues, _filterOps, _setSelections) = RaptorGridBuilder.BuildFilterState(_prepared.State);
    }

    private RenderFragment RenderCell(GridColumn<TRow> col, TRow row) => builder =>
    {
        var template = _specByKey.TryGetValue(col.Key, out var spec) ? spec.CellTemplate : null;
        if (template is not null)
            builder.AddContent(0, template(row));
        else if (col.Cell is not null)
            builder.AddMarkupContent(1, col.Cell(row).Html);
        else
            builder.AddContent(2, col.Value?.Invoke(row)?.ToString());
    };

    private static bool HasPopup(GridColumn<TRow> c) =>
        c.Filter is GridFilterType.Text or GridFilterType.Number or GridFilterType.Date
        || (c.Filter == GridFilterType.Set && c.SetOptions is { Count: > 0 });

    private static string AlignClass(string? align) => align switch
    {
        "center" => "rg-al-center",
        "right" => "rg-al-right",
        _ => "rg-al-left"
    };

    /// <summary>Deterministic bar width for a skeleton cell, keyed off the column index — cycles through a
    /// few widths so a skeleton row reads as plausible data rather than a uniform block.</summary>
    private static string SkeletonWidthClass(int columnIndex) => (columnIndex % 4) switch
    {
        0 => "rg-skeleton-w60",
        1 => "rg-skeleton-w80",
        2 => "rg-skeleton-w40",
        _ => "rg-skeleton-w70"
    };
}
