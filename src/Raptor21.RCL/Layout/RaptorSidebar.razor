@namespace Raptor21.RCL.Layout

@* Both bands Off — the component contributes no markup at all. This is the ONLY case decided on the
   server, because it is the only one that does not depend on the viewport. *@

@* ATTRIBUTES THE RUNTIME ADDS TO THIS ELEMENT, so nobody diffing server output against live DOM reads
   them as drift:
     tabindex="-1"  written by FocusTrap (Client/src/core/focus.ts) the first time a mobile drawer is
                    opened, and NOT removed on release — the trap only ever adds it when absent. With
                    Preserve="true" the node outlives navigations, so the attribute is permanent from
                    the first open. Harmless (a -1 tabindex is skipped by Tab and only makes the rail
                    programmatically focusable, which is what the trap needs); ModalComponent has had
                    the identical behaviour since it started using the same class. *@
@if (MobileMode is not RaptorSidebarMode.Off || DesktopMode is not RaptorSidebarMode.Off)
{
<aside class="@RootCssClass" id="@Id" hx-preserve="@PreserveAttribute"
       popover="auto"
       data-rg-sidebar-mode="@ModeToken(MobileMode)"
       data-rg-sidebar-desktop="@ModeToken(DesktopMode)"
       @attributes="AdditionalAttributes">

    @* The dimmed page behind an open drawer, AND the surface that closes it.
       Deliberately a real element inside the rail rather than the popover's own `::backdrop`: measured
       in Chrome, `pointer-events` is not author-settable on a popover `::backdrop` — `!important` at
       (0,3,1) still computed `none`, while the `background` in the very same rule applied. A backdrop
       that cannot be hit means the "touch the page to close it" gesture lands on the PAGE: one real tap
       beside an open rail was measured closing the drawer AND firing the `hx-confirm` Delete button it
       landed on. As a DOM descendant this scrim is inside the popover for hit-testing and for
       light-dismiss, so the tap is absorbed — which is also why closing it is wired explicitly in
       Client/src/runtime/sidebar.ts; the UA's light-dismiss does not fire for a tap inside the subtree.
       Rendered at every width and inert above 992px (`display: none`) — see _sidebar.scss §3. *@
    <div class="rg-sidebar-scrim" aria-hidden="true"></div>

    @if (Brand is not null)
    {
        <div class="@BrandCssClass">
            @Brand
        </div>
    }

    @if (ShowToggle)
    {
        @* aria-expanded, not aria-pressed: this collapses/expands the rail, and its collapsed form
           (Rail) still shows the icons, so "expanded" is the honest state name. The client flips both
           the attribute and data-rg-sidebar-desktop; see Client/src/runtime/sidebar.ts. *@
        <button type="button" class="@ToggleCssClass" aria-label="@ToggleLabel"
                data-rg-sidebar-rail-toggle
                aria-controls="@Id"
                aria-expanded="@(DesktopMode is RaptorSidebarMode.Rail ? "false" : "true")">
            @ToggleContent
        </button>
    }

    <div class="@ScrollCssClass" id="@ScrollId">
        @Menu
    </div>

    @if (Bottom is not null)
    {
        <div class="@BottomCssClass">
            @Bottom
        </div>
    }

</aside>
}

@code {

    /// <summary>The rail's element id. Must be stable across navigations for <see cref="Preserve"/> to
    /// work — htmx matches the preserved node to the response by id.</summary>
    [Parameter]
    public string Id { get; set; } = "sidebar";

    /// <summary>Emit <c>hx-preserve="true"</c> on the rail so boosted navigations keep the live node,
    /// along with any client state and event bindings held inside it. On by default; turn it off for a
    /// rail that has to re-render per navigation.</summary>
    [Parameter]
    public bool Preserve { get; set; } = true;

    /// <summary>How the rail presents itself below 992px. Default <see cref="RaptorSidebarMode.Drawer"/>.
    /// <para>Emitted as <c>data-rg-sidebar-mode</c> ON THE RAIL ITSELF. It is deliberately not written to
    /// the host's <c>&lt;html&gt;</c> element: a library that reaches out of its own subtree to mark the
    /// document root owns state it cannot see the other writers of, which is exactly how the vendored
    /// menu script this replaces ended up with a five-way <c>data-toggled</c> state machine. Layout rules
    /// that need the mode read it back with <c>html:has(.rg-sidebar[data-rg-sidebar-mode="…"])</c>.</para>
    /// </summary>
    [Parameter]
    public RaptorSidebarMode MobileMode { get; set; } = RaptorSidebarMode.Drawer;

    /// <summary>How the rail presents itself from 992px up. Default <see cref="RaptorSidebarMode.Docked"/>.
    /// Emitted as <c>data-rg-sidebar-desktop</c>. <see cref="RaptorSidebarMode.Drawer"/> and
    /// <see cref="RaptorSidebarMode.Push"/> are mobile-band behaviours and are treated as
    /// <see cref="RaptorSidebarMode.Docked"/> here — the stylesheet has no desktop rules for them.</summary>
    [Parameter]
    public RaptorSidebarMode DesktopMode { get; set; } = RaptorSidebarMode.Docked;

    /// <summary>Classes appended to the rail, after <c>rg-sidebar</c>.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>Brand/logo content. The wrapper is omitted entirely when this is not supplied.</summary>
    [Parameter]
    public RenderFragment? Brand { get; set; }

    /// <summary>Classes appended to the brand wrapper, after <c>rg-sidebar-brand</c>.</summary>
    [Parameter]
    public string? BrandClass { get; set; }

    /// <summary>The menu, rendered inside the scroll region. Everything about it — structure, item
    /// markup, expansion behaviour — belongs to the consumer.</summary>
    [Parameter]
    public RenderFragment? Menu { get; set; }

    /// <summary>The scroll region's element id, for scrollbar plugins and CSS that sizes it.</summary>
    [Parameter]
    public string? ScrollId { get; set; } = "sidebar-scroll";

    /// <summary>Classes appended to the scroll region, after <c>rg-sidebar-scroll</c>.</summary>
    [Parameter]
    public string? ScrollClass { get; set; }

    /// <summary>Render the collapse/expand control. On by default.</summary>
    [Parameter]
    public bool ShowToggle { get; set; } = true;

    /// <summary>Classes appended to the collapse control, after <c>rg-sidebar-toggle</c>. This is where
    /// a consumer puts the class its own menu script binds to.</summary>
    [Parameter]
    public string? ToggleClass { get; set; }

    /// <summary>Accessible name for the collapse control.</summary>
    [Parameter]
    public string ToggleLabel { get; set; } = "Toggle sidebar";

    /// <summary>The collapse control's content — an icon, usually. Left unset, the button renders
    /// empty.</summary>
    [Parameter]
    public RenderFragment? ToggleContent { get; set; }

    /// <summary>Pinned foot below the scroll region. The wrapper is omitted entirely when this is not
    /// supplied.</summary>
    [Parameter]
    public RenderFragment? Bottom { get; set; }

    /// <summary>Classes appended to the foot wrapper, after <c>rg-sidebar-bottom</c>.</summary>
    [Parameter]
    public string? BottomClass { get; set; }

    /// <summary>Splatted onto the rail element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object?>? AdditionalAttributes { get; set; }

    private string? PreserveAttribute => Preserve ? "true" : null;

    private string RootCssClass => Combine("rg-sidebar", Class);
    private string BrandCssClass => Combine("rg-sidebar-brand", BrandClass);
    private string ScrollCssClass => Combine("rg-sidebar-scroll", ScrollClass);
    private string ToggleCssClass => Combine("rg-sidebar-toggle", ToggleClass);
    private string BottomCssClass => Combine("rg-sidebar-bottom", BottomClass);

    private static string Combine(string ownClass, string? extra)
        => string.IsNullOrWhiteSpace(extra) ? ownClass : $"{ownClass} {extra}";

    /// <summary>Lowercase attribute token for a mode. Hand-written rather than <c>ToString().ToLower()</c>
    /// so a renamed enum member breaks the build here instead of silently unmatching a selector.</summary>
    private static string ModeToken(RaptorSidebarMode mode) => mode switch
    {
        RaptorSidebarMode.Drawer => "drawer",
        RaptorSidebarMode.Push   => "push",
        RaptorSidebarMode.Rail   => "rail",
        RaptorSidebarMode.Docked => "docked",
        RaptorSidebarMode.Off    => "off",
        _                        => "drawer"
    };

}
