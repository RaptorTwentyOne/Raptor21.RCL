@using Raptor21.RCL.Grid
@model (GridViewModel Grid, GridColumnView Col, int RowSpan)
@{
    var m = Model.Grid;
    var col = Model.Col;

    string AlignClass(string? align) => align switch
    {
        "center" => "rg-al-center",
        "right" => "rg-al-right",
        _ => "rg-al-left"
    };

    bool HasPopup(GridColumnView c) =>
        c.Filter is GridFilterType.Text or GridFilterType.Number or GridFilterType.Date
        || (c.Filter == GridFilterType.Set && c.SetOptions is { Count: > 0 });

    var isSorted = string.Equals(col.Key, m.SortField, StringComparison.OrdinalIgnoreCase);
    var nextDir = isSorted && m.SortDir == "asc" ? "desc" : "asc";
    var thStyle = col.Width is { } w ? $"width:{w}px" : (col.MinWidth is { } mw ? $"min-width:{mw}px" : null);
    var isActive = m.FilterValues.ContainsKey(col.Key) || m.SetSelections.ContainsKey(col.Key);
    var reorderable = col.Pinned is null;
    var resizable = col.Pinned != "right";
}
<th scope="col" data-rg-col="@col.Key"
    rowspan="@(Model.RowSpan > 1 ? Model.RowSpan.ToString() : null)"
    class="@AlignClass(col.Align ?? (col.Filter == GridFilterType.Number ? "right" : null)) @(reorderable ? "rg-reorder" : null) @col.CssClass"
    draggable="@(reorderable ? "true" : "false")"
    @(resizable ? $"data-rg-min={col.MinWidth ?? 60}" : "")
    @(thStyle is null ? "" : $"style={thStyle}")>
    <div class="rg-hd">
        @if (col.Sortable)
        {
            var sortVals = $"{{\"sort\":\"{col.Key}\",\"dir\":\"{nextDir}\",\"page\":\"1\"}}";
            <button type="button" class="rg-sort" hx-post="@m.Endpoint" hx-vals="@sortVals">
                <span>@col.Header</span>
                @if (isSorted)
                {
                    <span class="rg-ico rg-arrow @(m.SortDir == "asc" ? "rg-ico-sort-asc" : "rg-ico-sort-desc")"></span>
                }
                else
                {
                    <span class="rg-ico rg-arrow-idle rg-ico-sort"></span>
                }
            </button>
        }
        else
        {
            <span class="rg-title">@col.Header</span>
        }

        @if (HasPopup(col))
        {
            <button type="button" class="rg-funnel @(isActive ? "active" : "")" data-rg-toggle="@col.Key" aria-label="Filter @col.Header" title="Filter">
                <span class="rg-ico rg-ico-filter"></span>
            </button>
        }
    </div>
    @if (resizable)
    {
        <span class="rg-resize" data-rg-resize></span>
    }
</th>
