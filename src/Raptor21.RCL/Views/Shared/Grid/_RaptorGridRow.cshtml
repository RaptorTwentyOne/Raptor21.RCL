@using Raptor21.RCL.Grid
@model GridRowViewModel
@{
    string AlignClass(string? align) => align switch
    {
        "center" => "rg-al-center",
        "right" => "rg-al-right",
        _ => "rg-al-left"
    };

    var hasDetail = Model.HasDetail && !string.IsNullOrEmpty(Model.DetailUrl);
    var detailId = $"{Model.GridId}-detail-{Model.Row.Key}";
    var detailUrl = hasDetail ? Model.DetailUrl!.Replace("{key}", Model.Row.Key) : null;
}
<tr data-row-key="@Model.Row.Key">
    @if (hasDetail)
    {
        <td class="rg-expand-cell">
            <button type="button" class="rg-expand" data-rg-expand="@detailId" data-rg-detail-url="@detailUrl" aria-expanded="false" aria-label="Expand row">
                <span class="rg-ico rg-ico-chevron"></span>
            </button>
        </td>
    }
    @if (Model.Selectable)
    {
        <td class="rg-sel-cell"><input type="checkbox" class="rg-sel-row" value="@Model.Row.Key" aria-label="Select row" /></td>
    }
    @for (var i = 0; i < Model.Row.Cells.Count; i++)
    {
        var col = Model.Columns[i];
        var cell = Model.Row.Cells[i];
        var editable = Model.CanEdit && col.Editable && !string.IsNullOrEmpty(col.Editor);
        <td data-rg-field="@col.Key" data-label="@col.Header"
            class="@AlignClass(col.Align ?? (col.Filter == GridFilterType.Number ? "right" : null)) @(col.Wrap ? "rg-wrap" : null) @(editable ? "rg-editable" : null) @cell.CssClass"
            @(editable ? $"data-rg-edit={col.Editor}" : "")
            @(cell.Tooltip is null ? "" : $"title={cell.Tooltip}")>
            @Html.Raw(cell.Html)
        </td>
    }
    @if (Model.Row.CardHtml is { } cardHtml)
    {
        <td class="rg-card" colspan="@Model.SpanColumns">@Html.Raw(cardHtml)</td>
    }
</tr>
@if (hasDetail)
{
    <tr class="rg-detail-row" data-detail-row="@Model.Row.Key" hidden>
        <td colspan="@Model.SpanColumns" class="rg-detail-cell">
            <div id="@detailId" class="rg-detail">
                <div class="rg-detail-loading"><span class="rg-ico rg-ico-spinner rg-ico-spin"></span> Loading…</div>
            </div>
        </td>
    </tr>
}
